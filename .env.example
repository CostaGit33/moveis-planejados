# Exemplo de variáveis de ambiente
# A API consolidada usa a porta 8090 por padrão.
DB_USER=seu_user
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orcamentos_moveis

TELEGRAM_BOT_TOKEN=seu_token
TELEGRAM_ADMIN_ID=seu_id
ANTHROPIC_API_KEY=sua_key
API_URL=http://localhost:8090

# FRONTEND (se usar um app React separado)
REACT_APP_API_URL=http://localhost:8090

# API
PORT=8090
OUT_DIR=./saida_poc

# INTERPRETAÇÃO VISUAL DE RASCUNHOS (OpenAI-compatible)
# Em produção, configure no serviço da API; nunca publique a chave no frontend.
VISION_API_BASE=https://seu-provedor.example/v1
VISION_API_KEY=configure_no_servidor
VISION_MODEL=gemini-3-flash-preview
VISION_MAX_IMAGE_BYTES=8388608
